{
  "name": "@partflow/inventory-api",
  "version": "0.1.0",
  "description": "PartFlow inventory API: parts, stock movements, purchase orders, transactional outbox to Kafka",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/telemetry.js dist/server.js",
    "start:relay": "node --import ./dist/telemetry.js dist/relay-main.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "node dist/migrate-main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx bench/stock-movements.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-fastify": "^0.56.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.12.5",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
